    "voice": "Guoman-mature-synthetic-v1",
    "referenceSha256": "5a5efcdcdb61055c4ddf57d3c3bff5dce297b263fcc02feb9bcc3245ae19d4a7"
  },
  {
    "turn": 20,
    "text": "他们都很健康，没有什么严重的问题。",
    "src": "/assets/patient-audio/turn-20.mp3",
    "duration": 3.44,
    "sha256": "6fbb655a23fe1ed63dae56941fe1702faf35025caa7e3c0f5a03c82382b9d1d4",
    "model": "Qwen3-TTS-12Hz-0.6B-Base",
