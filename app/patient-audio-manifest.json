    "src": "/assets/patient-audio/turn-24.mp3",
    "duration": 3.2,
    "sha256": "e8466ae34fb862fae0fa4fb0ea5a58c6d80bfcd85191aced4ae3b52517e95365",
    "model": "Qwen3-TTS-12Hz-0.6B-Base",
